# Reference for your supervisor. The app reads environment variables from the process.
NODE_ENV=production
PORT=4173
LUNARA_ORIGIN=https://lunara.example.com
LUNARA_DB=/srv/lunara-data/lunara.sqlite
LUNARA_DB_KEY=
LUNARA_TLS_CERT_FILE=/etc/lunara/tls/fullchain.pem
LUNARA_TLS_KEY_FILE=/etc/lunara/tls/privkey.pem
LUNARA_REQUEST_LOG=1

# Optional local Ollama routing
# LUNARA_AI_PROVIDER=ollama
# LUNARA_OLLAMA_PORT=11434
# LUNARA_OLLAMA_MODEL=qwen2.5:0.5b
